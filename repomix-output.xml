/* =================================================================
   HİKAYEMİZ (STORY TIMELINE) BÖLÜMÜ
   ================================================================= */
.story-card {
  padding-bottom: 60px !important;
}

.story-timeline-container {
  position: relative;
  max-width: 900px;
  margin: 40px auto 0;
  padding: 20px 0;
}

.story-line {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 2px;
  background: linear-gradient(180deg, transparent, var(--rose), var(--rose-dark), transparent);
  transform: translateX(-50%);
}

.story-node {
  position: relative;
  width: 50%;
  padding: 0 40px 40px;
  box-sizing: border-box;
}

.story-node.left {
  left: 0;
  text-align: right;
}

.story-node.right {
  left: 50%;
  text-align: left;
}

.story-dot {
  position: absolute;
  top: 0;
  width: 20px;
  height: 20px;
  background: var(--paper);
  border: 4px solid var(--rose-dark);
  border-radius: 50%;
  z-index: 2;
  box-shadow: 0 0 0 4px rgba(159, 79, 104, 0.2);
}

.story-node.left .story-dot { right: -10px; }
.story-node.right .story-dot { left: -10px; }

.story-content-box {
  background: var(--paper-soft);
  padding: 24px;
  border-radius: 20px;
  border: 1px solid rgba(217, 140, 161, 0.3);
  box-shadow: 0 10px 30px rgba(111, 47, 67, 0.06);
  position: relative;
  top: -20px; /* Dot ile hizalamak için */
}

.story-date {
  display: inline-block;
  color: var(--rose-dark);
  font-family: "Playfair Display", serif;
  font-weight: 800;
  font-size: 14px;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 8px;
  background: rgba(217, 140, 161, 0.15);
  padding: 6px 14px;
  border-radius: 999px;
}

.story-heading {
  color: var(--text);
  font-family: "Playfair Display", serif;
  font-size: 24px;
  font-weight: 800;
  margin: 0 0 12px;
}

.story-desc {
  color: var(--text-soft);
  font-size: 17px;
  line-height: 1.6;
  margin: 0;
}

.story-image {
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 16px;
  margin-top: 16px;
  border: 1px solid rgba(217, 140, 161, 0.2);
}

/* Mobil Cihazlar İçin Çizgiyi Sola Alma */
@media (max-width: 768px) {
  .story-line {
    left: 20px;
  }
  .story-node {
    width: 100%;
    padding: 0 0 40px 50px;
    text-align: left !important;
  }
  .story-node.right {
    left: 0;
  }
  .story-node.left .story-dot,
  .story-node.right .story-dot {
    left: 10px;
    right: auto;
  }
}

