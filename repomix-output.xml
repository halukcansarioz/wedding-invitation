   ================================================================= */
.gallery-lightbox-overlay {
  position: fixed !important;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: 0 !important;  
  width: 100vw !important;
  height: 100vh !important;
  height: 100dvh !important;
