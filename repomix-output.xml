  z-index: 0;
}

/* Sağ alt veya diğer köşelerdeki dekorlar için de tam tersini uygula */
.decoration-bottom-right {
  position: absolute;
  bottom: 40px;  /* padding-bottom ile eşitleyin */
  right: 20px; /* padding-right ile eşitleyin */
  max-width: 80px;
  height: auto;
}

/* Zıplama (Bounce) Animasyonu Tanımı */
@keyframes jump-animation {
  0%   { transform: translateY(0) scale(1); }
  50%  { transform: translateY(-8px) scale(1.05); } /* Yukarı doğru 8px zıplar ve çok hafif büyür */
  100% { transform: translateY(0) scale(1); }
}

/* Dil ve Müzik Butonu İçin Animasyonun Uygulanması */
.dock-btn.lang-btn:hover,
.dock-btn.lang-btn:active,
.dock-btn.music-btn:hover,
.dock-btn.music-btn:active {
  /* Fare üzerindeyken veya tıklandığında zıplama efektini tetikler */
  animation: jump-animation 0.4s ease-in-out;
}

/* Opsiyonel: Eğer fare üzerinde beklediği sürece SÜREKLİ zıplamasını isterseniz 
   yukarıdaki 'animation' satırını şu şekilde değiştirebilirsiniz:
   animation: jump-animation 0.5s ease-in-out infinite; 
*/
