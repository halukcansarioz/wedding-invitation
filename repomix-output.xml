  font-size: clamp(32px, 4vw, 46px);
  font-weight: 800;
}

.card h2::after,
.countdown-section h2::after {
  content: "";
  display: block;
  width: 84px;
  height: 2px;
  margin: 18px auto 0;
  background: linear-gradient(90deg, transparent, var(--rose), transparent);
}

.card p,
.countdown-section p,
.empty-text,
.footer small {
  position: relative;
  max-width: 820px;
  margin: 0 auto;
