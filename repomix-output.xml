}

.empty-text {
  font-size: 18px !important;
}

.wish-item {
  padding: 24px;
  border-radius: 24px;
}

.wish-item p {
  color: var(--text);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 21px;
  font-weight: 600;
}

.wish-item strong {
  margin-top: 12px;
  color: var(--rose-dark);
  font-size: 20px;
}

.footer {
  padding: 50px 18px 0;
  text-align: center;
}

.footer p {
  margin: 0;
  color: var(--rose-dark);
  font-family: "Great Vibes", "Noto Serif", cursive;
  font-size: clamp(48px, 7vw, 86px);
  line-height: 1.2;
  text-shadow: 0 8px 24px rgba(217, 140, 161, 0.28);
}

.footer span {
  display: block;
  margin-top: 8px;
  color: var(--rose-dark);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 15px;
