.admin-sidebar-title small, .admin-nav-button small, .admin-current-section span { font-family: "Playfair Display", serif; font-size: 13px; font-weight: 700; line-height: 1.4; }

.admin-sidebar-menu { display: grid; gap: 10px; }
.admin-nav-button { width: 100%; min-height: 72px; padding: 13px 14px; display: grid; gap: 5px; border-radius: 18px; text-align: left; transition: 0.2s ease; }
.admin-nav-button span { font-family: "Playfair Display", serif; font-size: 16px; font-weight: 800; }

.admin-nav-button:hover {
  transform: translateX(3px);
  border-color: rgba(159, 79, 104, 0.48);
  background: rgba(255, 240, 244, 0.82);
}

.admin-nav-button.active {
  border-color: rgba(159, 79, 104, 0.64);
  background: linear-gradient(135deg, #8f7fb8, #6f4b7a);
  box-shadow: 0 18px 40px rgba(100, 50, 90, 0.26), inset 0 -4px 18px rgba(0,0,0,0.06);
  padding: 18px 20px;
  border-radius: 24px;
  position: relative;
}

.admin-nav-button.active span,
.admin-nav-button.active small {
  color: #ffffff;
}

.admin-nav-button.active::after {
  content: "";
  position: absolute;
  top: -4px;
  right: -4px;
  bottom: -4px;
  left: -4px;
  border-radius: 28px;
  border: 2px solid rgba(0,0,0,0.12);
  pointer-events: none;
}

.admin-main-panel { min-width: 0; }
.admin-main-panel .admin-actions-sticky { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px; padding: 16px 20px; }
.admin-actions-sticky .admin-save-message { flex: 1 1 100%; width: 100%; order: 99; margin: 4px 0 0 0; padding: 12px 16px; border-radius: 12px; text-align: center; font-weight: 800; }
.admin-current-section { min-width: min(100%, 160px); display: grid; gap: 4px; margin-right: auto; }
.admin-current-section strong { font-family: "Playfair Display", serif; font-size: 19px; font-weight: 800; }

.admin-save-message { width: 100%; }
.admin-editor-single { margin: 0; }
.admin-editor-single .admin-editor-section { margin: 0; }
.admin-gallery-list { margin-top: 18px; }

.admin-stats-inside {
  max-width: none;
  margin: 0 0 22px;
  grid-template-columns: repeat(3, 1fr);
}

.admin-list-full {
  max-height: 680px;
}

@media (max-width: 1100px) {
  .admin-layout { grid-template-columns: 240px minmax(0, 1fr); }
  .admin-shell-card { padding: 28px 22px; }
}

@media (max-width: 900px) {
  .admin-layout { grid-template-columns: 1fr; }
  .admin-sidebar { position: relative; top: auto; max-height: none; }
  .admin-sidebar-menu { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .admin-nav-button:hover { transform: translateX(2px); }
  .admin-main-panel .admin-actions-sticky { position: sticky; top: 10px; }
  .admin-stats-inside { grid-template-columns: repeat(2, 1fr); }
