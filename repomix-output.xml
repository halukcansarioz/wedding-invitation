/* =================================================================
   TAM EKRAN (FULL-SCREEN) ZARF AÇILIŞ ANİMASYONU (TAM SENKRONİZE)
   ================================================================= */
.intro-page {
  padding: 0 !important;
  position: fixed;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: 0 !important;  
  z-index: 9999;
  background: transparent;
}

.envelope-container {
  position: absolute;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: 0 !important;  width: 100vw !important;
  height: 100vh !important;
  height: 100dvh !important;
  margin: 0;
  -webkit-perspective: 1500px;
  perspective: 1500px;
  z-index: 10;
  display: block;
  overflow: hidden;
  -webkit-transition: opacity 0.8s ease 3.2s;
  transition: opacity 0.8s ease 3.2s;
}

.intro-page.opening .envelope-container {
  opacity: 0;
}

/* 1. KATMAN: Zarfın İç Arka Yüzeyi (Astar) */
.envelope-back {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;  
  background: linear-gradient(to bottom, color-mix(in srgb, var(--paper) 65%, var(--rose-dark) 35%), color-mix(in srgb, var(--paper) 85%, var(--rose-dark) 15%));
  box-shadow: inset 0 30px 70px rgba(0, 0, 0, 0.2) !important;
  z-index: 1;
}

.envelope-back::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0; 
  background-image: repeating-linear-gradient(45deg, transparent, transparent 15px, rgba(255, 255, 255, 0.12) 15px, rgba(255, 255, 255, 0.12) 30px);
  opacity: 0.5;
  pointer-events: none;
}

/* 2. KATMAN: Davetiye Kartı */
.intro-page .envelope-container .intro-card {
  position: absolute !important;
  top: 50% !important;
  left: 50% !important;
  bottom: auto !important;
  width: min(94vw, 860px) !important;
  height: auto !important;
  min-height: 78vh !important;
  max-height: 90vh !important;
  -webkit-transform: translate(-50%, -40%) scale(0.95) !important;
  transform: translate(-50%, -40%) scale(0.95) !important;
  z-index: 2;
  padding: 50px 32px !important;
  background: var(--paper) !important;
  border-radius: 12px !important;
  box-shadow: 0 10px 30px rgba(0,0,0,0.2) !important;
  -webkit-transition: -webkit-transform 2.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s !important;
  transition: transform 2.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s !important;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.intro-page.opening .envelope-container .intro-card {
  -webkit-transform: translate(-50%, -55%) scale(1.02) !important;
  transform: translate(-50%, -55%) scale(1.02) !important;
  box-shadow: 0 25px 60px rgba(0,0,0,0.3) !important;
}

.intro-page .envelope-container .intro-card .couple-title {
  font-size: clamp(42px, 10vw, 68px) !important;
  margin: 8px 0 !important;
}
.intro-page .envelope-container .intro-card .intro-small {
  font-size: clamp(13px, 3vw, 16px) !important;
  letter-spacing: 4px !important;
}

.envelope-front {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;  
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, color-mix(in srgb, var(--paper) 92%, #fff 8%) 0%, color-mix(in srgb, var(--paper) 75%, var(--rose-dark) 25%) 100%);
  -webkit-clip-path: polygon(0 0, 50% 60%, 100% 0, 100% 100%, 0 100%);
  clip-path: polygon(0 0, 50% 60%, 100% 0, 100% 100%, 0 100%);
  z-index: 3;
  -webkit-transform: translateY(0);
  transform: translateY(0);
  -webkit-filter: drop-shadow(0 -6px 16px rgba(0,0,0,0.2));
  filter: drop-shadow(0 -6px 16px rgba(0,0,0,0.2));
  -webkit-transition: -webkit-transform 2.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
  transition: transform 2.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
}

.intro-page.opening .envelope-front {
  -webkit-transform: translateY(100vh);
  transform: translateY(100vh);
}

/* 4. KATMAN: Zarfın Üst Kapağı */
.envelope-flap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 60.5%;
  background: linear-gradient(to bottom, color-mix(in srgb, var(--paper) 98%, #ffffff 2%) 0%, color-mix(in srgb, var(--paper) 70%, var(--rose-dark) 30%) 100%);
  -webkit-clip-path: polygon(0 0, 100% 0, 50% 100%);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  -webkit-transform-origin: top center;
  transform-origin: top center;
  z-index: 4;
  -webkit-transform: rotateX(0deg);
  transform: rotateX(0deg);
  -webkit-filter: drop-shadow(0 10px 18px rgba(0,0,0,0.25));
  filter: drop-shadow(0 10px 18px rgba(0,0,0,0.25));
  -webkit-transition: -webkit-transform 2.2s cubic-bezier(0.25, 1, 0.35, 1) 0.1s, z-index 0s 1.1s;
  transition: transform 2.2s cubic-bezier(0.25, 1, 0.35, 1) 0.1s, z-index 0s 1.1s;
}

.intro-page.opening .envelope-flap {
  -webkit-transform: rotateX(180deg);
  transform: rotateX(180deg);
  z-index: 1; 
}

.envelope-flap::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;  
  background: linear-gradient(135deg, transparent 48%, rgba(0,0,0,0.08) 50%, transparent 52%);
  pointer-events: none;
}

/* Desenli Tema Çiçekleri */
.envelope-front::before,
.envelope-flap::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: var(--amp-color);
  -webkit-mask-image: var(--theme-flower-svg);
  mask-image: var(--theme-flower-svg);
  -webkit-mask-size: 100px 100px;
  mask-size: 100px 100px;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-repeat: repeat;
  mask-repeat: repeat;
  opacity: 0.1;
  mix-blend-mode: multiply;
  pointer-events: none;
  z-index: 1;
}

.envelope-front::after,
.envelope-flap::after,
.intro-page.opening .envelope-flap::after {
  display: none !important;
}

/* 5. KATMAN: Mühür */
.envelope-container .envelope-seal::before {
  content: "";
  position: absolute;
  top: 3px;
  right: 3px;
  bottom: 3px;
  left: 3px;  
  border-radius: 50%;
  background: var(--amp-color, var(--rose-dark));
  z-index: -1;
  filter: blur(1.5px); 
  opacity: 0.85;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
}

.envelope-container .envelope-seal:hover {
  transform: translate(-50%, -50%) scale(1.06) translateZ(20px) !important;
}

.intro-page.opening .envelope-seal {
  -webkit-transform: translate(-50%, -50%) scale(1.4) !important;
  transform: translate(-50%, -50%) scale(1.4) !important;
  opacity: 0;
  pointer-events: none;
}

/* Davetli Etiketi */
.envelope-guest-badge {
  position: absolute !important;
  bottom: 40px !important;
  right: 40px !important;
  z-index: 20 !important;
  font-size: 18px !important;
  -webkit-transition: opacity 0.4s ease 0.2s !important;
  transition: opacity 0.4s ease 0.2s !important;
}

.intro-page.opening .envelope-guest-badge {
  opacity: 0 !important;
}


/* Mühür (Seal) */
.envelope-container .envelope-seal {
  position: absolute !important;
  top: 59% !important; 
  left: 50% !important;
  transform: translate(-50%, -50%) scale(1) translateZ(20px) !important;
  width: clamp(80px, 20vw, 120px) !important;
  height: clamp(80px, 20vw, 120px) !important;
  border-radius: 50%;
  border: none;
  background: radial-gradient(circle at 35% 25%, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0) 55%),
              linear-gradient(135deg, color-mix(in srgb, var(--amp-color, #8f7fb8) 85%, white) 0%, var(--amp-color, #8f7fb8) 60%, color-mix(in srgb, var(--amp-color, #8f7fb8) 70%, black) 100%);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4), inset 0 -4px 8px rgba(0, 0, 0, 0.3), inset 0 4px 8px rgba(255, 255, 255, 0.5);
  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;
  font-family: "Playfair Display", Georgia, serif !important;
  font-size: clamp(16px, 5vw, 20px) !important; 
  font-weight: 900 !important; 
  letter-spacing: 0.8px !important; 
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  cursor: pointer;
  transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease;
}

.envelope-container .envelope-seal span {
  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;
  opacity: 1 !important;
  mix-blend-mode: normal !important;
}

.envelope-container .envelope-seal::before {
  content: "";
  display: block;
  position: absolute;
  top: clamp(4px, 1.5vw, 6px);
  right: clamp(4px, 1.5vw, 6px);
  bottom: clamp(4px, 1.5vw, 6px);
  left: clamp(4px, 1.5vw, 6px);  border: 1.5px solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
}

.envelope-container .envelope-seal:hover {
  -webkit-transform: translate(-50%, -50%) scale(1.08) translateZ(20px) !important;
  transform: translate(-50%, -50%) scale(1.08) translateZ(20px) !important;
}

.intro-page.opening .envelope-seal {
  -webkit-transform: translate(-50%, -50%) scale(1.3) translateZ(20px) !important;
  transform: translate(-50%, -50%) scale(1.3) translateZ(20px) !important;
  opacity: 0;
  pointer-events: none;
}

