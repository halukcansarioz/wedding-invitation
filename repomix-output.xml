  padding: 20px 64px 20px 22px;
  background: color-mix(in srgb, var(--amp-color, #9f4f68) 6%, transparent);
  border: 1px solid rgba(159, 79, 104, 0.20);
  box-shadow: 0 12px 26px rgba(159, 79, 104, 0.07);
