  width: 230px;
  height: 230px;
  border-radius: 50%;
  background: rgba(248, 214, 224, 0.24);
}

.card::after {
  content: "❀";
  position: absolute;
  top: 26px;
  left: 30px;
  color: rgba(159, 79, 104, 0.28);
