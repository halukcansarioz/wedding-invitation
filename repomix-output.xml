}

.main-button:hover,
.secondary-button:hover { transform: translateY(-4px); }

.secondary-button:hover { background: #fff0f4; }

.timeline {
  position: relative;
  max-width: 760px;
  margin: 34px auto 0;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 100px;
  top: 8px;
