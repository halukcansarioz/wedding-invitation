}

.guest-stats div,
.guest-item,
.wish-item {
  border: 1px solid rgba(217, 140, 161, 0.3);
  background: var(--paper-soft);
}

.guest-stats div {
  padding: 24px 16px;
  border-radius: 24px;
}

.guest-list,
.wish-list {
  position: relative;
  max-width: 860px;
  margin: 28px auto 0;
  display: grid;
  gap: 14px;
}

.guest-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  padding: 18px 20px;
  border-radius: 20px;
  text-align: left;
}

.guest-item strong,
.wish-item strong {
  display: block;
  color: var(--rose-deep);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 21px;
  font-weight: 800;
}

.guest-item span {
  display: block;
  margin-top: 4px;
