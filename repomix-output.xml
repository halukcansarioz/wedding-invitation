<file path="src/styles/base.css">
* {
  box-sizing: border-box;
}

:root {
  --paper: #fffafb;
  --paper-soft: #fff7f9;
  --rose-light: #f8d7df;
  --rose: #d98ca1;
  --rose-dark: #9f4f68;
  --rose-deep: #7a2f49;
  --gold: #c69b5c;
  --dark-gold: #8a6735;
  --text: #55303b;
  --text-soft: #6f4451;
  --shadow: 0 20px 48px rgba(165, 112, 133, 0.12);
}

html,
body,
#root {
  width: 100%;
  min-height: 100%;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

body {
  font-family: "Cormorant Garamond", "Noto Serif", Georgia, serif;
  color: var(--text);
  background:
    radial-gradient(circle at top left, rgba(244, 196, 210, 0.28), transparent 34%),
    radial-gradient(circle at bottom right, rgba(252, 230, 237, 0.55), transparent 36%),
    linear-gradient(180deg, #fff8fa, #fbeef2);
}

button,
a,
input,
textarea {
  font-family: inherit;
}

button {
  cursor: pointer;
}

#root {
  max-width: none !important;
  text-align: initial !important;
}

.app {
  width: 100%;
  min-height: 100vh;
}

.intro-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  padding: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background:
    linear-gradient(rgba(165, 112, 133, 0.1), rgba(165, 112, 133, 0.32)),
    var(--intro-image) center/cover no-repeat;
}

.ribbon {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  background: rgba(255, 236, 241, 0.14);
  border: 1px solid rgba(255, 236, 241, 0.32);
  animation: ribbonOpen 1.5s ease forwards;
  pointer-events: none;
  z-index: 1;
}

.ribbon-left { left: 0; transform-origin: left; }
.ribbon-right { right: 0; transform-origin: right; }

@keyframes ribbonOpen {
  to { transform: scaleX(0); opacity: 0; }
}

.intro-card {
  position: relative;
  z-index: 2;
  width: min(92vw, 760px);
  padding: 60px 42px 54px;
  text-align: center;
  color: white;
  border-radius: 42px;
  background: rgba(214, 170, 186, 0.22);
  border: 1px solid rgba(255, 236, 241, 0.58);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  box-shadow: 0 28px 70px rgba(165, 112, 133, 0.18);
}

.leaf-mark::before {
  content: "❀";
  display: inline-block;
  margin-bottom: 18px;
  color: #d8b5be;
  font-size: 30px;
  line-height: 1;
}

.intro-small,
.small-title,
.section-label {
  margin: 0 0 14px;
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  color: var(--rose-dark);
  letter-spacing: 4px;
  font-size: 14px;
  font-weight: 800;
  text-transform: uppercase;
}

.intro-small,
.hero-section .small-title { color: #fff0f4; }

.couple-title {
  margin: 0;
  padding: 18px 10px 12px;
  font-family: "Great Vibes", "Noto Serif", cursive;
  color: #fffafb;
  font-size: clamp(64px, 10vw, 122px);
  line-height: 1.2;
  font-weight: normal;
  text-shadow: 0 4px 14px rgba(0, 0, 0, 0.22), 0 0 18px rgba(255, 220, 230, 0.22);
}

.couple-title span,
.couple-title em { display: inline-block; vertical-align: middle; }

.couple-title em {
  margin: 0 18px;
  font-family: "Cormorant Garamond", "Noto Serif", Georgia, serif;
  font-style: normal;
  font-size: 0.54em;
  color: #f0cf88;
}

.intro-text {
  max-width: 560px;
  margin: 4px auto 0;
  color: #fff7f9;
  font-size: 23px;
  line-height: 1.85;
  text-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
}

.open-button {
  margin-top: 34px;
  padding: 16px 44px;
  border: 1px solid rgba(255, 236, 241, 0.7);
  border-radius: 999px;
  background: linear-gradient(135deg, #fff1f5, #ebb4c4, #c97b93);
  color: #5b3340;
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: 1px;
  box-shadow: 0 12px 28px rgba(165, 112, 133, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  transition: 0.25s ease;
}

.open-button:hover {
  transform: translateY(-4px);
  background: linear-gradient(135deg, #fff7f9, #f1bfd0, #cf88a0);
}

.invitation-page {
  position: relative;
  width: 100%;
  max-width: 1500px;
  margin: 0 auto;
  padding: 30px 42px 76px;
  scroll-snap-type: none !important;
  padding-bottom: 120px !important;
}

.invitation-page::before {
  content: "";
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(circle at 8% 18%, rgba(217, 140, 161, 0.12), transparent 12%),
    radial-gradient(circle at 90% 28%, rgba(248, 199, 211, 0.16), transparent 13%),
    radial-gradient(circle at 18% 82%, rgba(217, 140, 161, 0.1), transparent 12%),
    radial-gradient(circle at 88% 86%, rgba(248, 199, 211, 0.14), transparent 12%);
}

.hero-section {
  position: relative;
  min-height: 760px;
  padding: 70px 38px 160px; 
  display: flex;
  align-items: flex-end; 
  justify-content: center;
  overflow: hidden;
  border-radius: 46px;
  text-align: center;
  color: white;
  background:
    linear-gradient(to bottom, rgba(165, 112, 133, 0.08), rgba(165, 112, 133, 0.34)),
    var(--hero-image) center/cover no-repeat;
  box-shadow: var(--shadow);
}

.hero-section::before {
  content: "";
  position: absolute;
  top: 18px;
  right: 18px;
  bottom: 18px;
  left: 18px;
  border: 1px solid rgba(255, 238, 243, 0.55);
  border-radius: 34px;
}

.hero-section::after {
  content: "❀";
  position: absolute;
  top: 38px;
  left: 50%;
  transform: translateX(-50%);
  color: #d8b5be;
  font-size: 28px;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero-date {
  display: inline-block;
  margin: 14px 0 0;
  padding: 10px 30px;
  border: 1px solid rgba(255, 236, 241, 0.58);
  border-radius: 999px;
  background: rgba(214, 170, 186, 0.26);
  color: #fffafb;
  font-size: 28px;
  letter-spacing: 1px;
  box-shadow: 0 10px 24px rgba(165, 112, 133, 0.12);
}

.hero-time {
  margin: 16px 0 0;
  color: #fff9fb;
  font-size: 24px;
  letter-spacing: 1px;
}

.card,
.countdown-section {
  position: relative;
  margin-top: 30px;
  padding: 48px 40px;
  overflow: hidden;
  border: 1px solid rgba(234, 180, 197, 0.28);
  border-radius: 38px;
  background: linear-gradient(145deg, rgba(255, 252, 253, 0.98), rgba(252, 239, 244, 0.98));
  text-align: center;
  box-shadow: var(--shadow);
}

.card::before,
.countdown-section::before {
  content: "";
  position: absolute;
  top: -90px;
  right: -90px;
  width: 230px;
  height: 230px;
  border-radius: 50%;
  background: rgba(248, 214, 224, 0.24);
}

.card::after {
  content: "❀";
  position: absolute;
  top: 26px;
  left: 30px;
  color: rgba(159, 79, 104, 0.28);
  font-size: 26px;
}

.card h2,
.countdown-section h2 {
  position: relative;
  margin: 0 0 20px;
  color: var(--rose-deep);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: clamp(32px, 4vw, 46px);
  font-weight: 800;
}

.card h2::after,
.countdown-section h2::after {
  content: "";
  display: block;
  width: 84px;
  height: 2px;
  margin: 18px auto 0;
  background: linear-gradient(90deg, transparent, var(--rose), transparent);
}

.card p,
.countdown-section p,
.empty-text,
.footer small {
  position: relative;
  max-width: 820px;
  margin: 0 auto;
  color: #5a2f3c;
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 22px;
  font-weight: 600;
  line-height: 1.9;
}

.invitation-card p {
  font-size: 25px;
  line-height: 2;
}

.countdown-grid {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  max-width: 980px;
  margin: 28px auto 0;
}

.count-box {
  padding: 28px 12px;
  border: 1px solid rgba(217, 140, 161, 0.34);
  border-radius: 28px;
  background: var(--paper);
  box-shadow: 0 14px 30px rgba(111, 47, 67, 0.08);
}

.count-box strong,
.guest-stats strong {
  display: block;
  color: var(--rose-dark);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 46px;
  font-weight: 800;
}

.count-box span,
.guest-stats span {
  display: block;
  margin-top: 10px;
  color: #7a4a58;
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.info-list {
  position: relative;
  max-width: 900px;
  margin: 28px auto 8px;
  overflow: hidden;
  border: 1px solid rgba(217, 140, 161, 0.34);
  border-radius: 26px;
  background: var(--paper-soft);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 26px;
  padding: 20px 26px;
  border-bottom: 1px solid rgba(217, 140, 161, 0.22);
  text-align: left;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row span,
.timeline-item span {
  color: var(--rose-dark);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-weight: 800;
}

.info-row span {
  font-size: 15px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.info-row strong {
  color: var(--text);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 22px;
  font-weight: 700;
}

.mini-map {
  position: relative;
  max-width: 900px;
  height: 360px;
  margin: 30px auto 0;
  overflow: hidden;
  border: 1px solid rgba(217, 140, 161, 0.36);
  border-radius: 28px;
  background: var(--paper-soft);
  box-shadow: 0 18px 42px rgba(111, 47, 67, 0.16);
}

.mini-map iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
}

.button-group {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
  margin-top: 28px;
}

.main-button,
.secondary-button {
  display: inline-block;
  padding: 16px 36px;
  border-radius: 999px;
  text-decoration: none;
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 0.8px;
  transition: 0.25s ease;
}

.main-button {
  border: none;
  background: linear-gradient(135deg, #e69aae, var(--rose-dark));
  color: white;
  box-shadow: 0 16px 34px rgba(159, 79, 104, 0.32);
}

.secondary-button {
  border: 1.5px solid rgba(217, 140, 161, 0.42);
  background: var(--paper);
  color: var(--rose-dark);
  box-shadow: 0 12px 28px rgba(111, 47, 67, 0.08);
}

.main-button:hover,
.secondary-button:hover { transform: translateY(-4px); }

.secondary-button:hover { background: #fff0f4; }

.timeline {
  position: relative;
  max-width: 760px;
  margin: 34px auto 0;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 100px;
  top: 8px;
  bottom: 8px;
  width: 2px;
  background: linear-gradient(var(--rose), var(--rose-dark));
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 90px 1fr;
  gap: 28px;
  align-items: center;
  margin-bottom: 22px;
  text-align: left;
}

.timeline-item span {
  font-size: 21px;
}

.timeline-item p {
  margin: 0;
  padding: 18px 22px;
  border: 1px solid rgba(217, 140, 161, 0.28);
  border-radius: 20px;
  background: var(--paper-soft);
  color: var(--text);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 21px;
  font-weight: 700;
}

.gallery-grid {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-top: 34px;
}

.gallery-grid img {
  width: 100%;
  height: 260px;
  object-fit: cover;
  border: 1px solid rgba(255, 230, 237, 0.7);
  border-radius: 28px;
  box-shadow: 0 18px 42px rgba(111, 47, 67, 0.18);
}

.rsvp-card {
  overflow: visible;
  border: 1px solid rgba(217, 140, 161, 0.42);
  background:
    radial-gradient(circle at top right, rgba(248, 199, 211, 0.45), transparent 24%),
    linear-gradient(145deg, rgba(255, 250, 251, 0.98), rgba(249, 226, 232, 0.98));
}

.rsvp-card h2 {
  font-size: 42px;
}

.rsvp-card > p {
  color: var(--text-soft);
  font-size: 21px;
}

.rsvp-form,
.wish-form {
  position: relative;
  max-width: 820px;
  margin: 32px auto 0;
  display: grid;
  gap: 16px;
}

.rsvp-form input,
.rsvp-form textarea,
.wish-form input,
.wish-form textarea {
  width: 100%;
  padding: 17px 18px;
  border: 1.5px solid rgba(217, 140, 161, 0.48);
  border-radius: 20px;
  outline: none;
  background: #fff8fa;
  color: var(--text);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 18px;
  font-weight: 700;
  box-shadow: 0 10px 24px rgba(111, 47, 67, 0.07);
}

.rsvp-form textarea,
.wish-form textarea {
  min-height: 135px;
  resize: vertical;
  line-height: 1.6;
}

.rsvp-form input:focus,
.rsvp-form textarea:focus,
.wish-form input:focus,
.wish-form textarea:focus {
  border-color: var(--rose-dark);
  box-shadow: 0 0 0 4px rgba(217, 140, 161, 0.18);
}

.rsvp-form input::placeholder,
.rsvp-form textarea::placeholder,
.wish-form input::placeholder,
.wish-form textarea::placeholder {
  color: #a65a70;
  opacity: 1;
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 17px;
  font-weight: 700;
}

.option-group {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.option-button {
  flex: 1;
  min-width: 140px;
  padding: 15px 18px;
  border: 1.5px solid rgba(217, 140, 161, 0.48);
  border-radius: 18px;
  background: #fff8fa;
  color: var(--text);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 17px;
  font-weight: 700;
  box-shadow: 0 10px 24px rgba(111, 47, 67, 0.07);
  transition: 0.2s ease;
}

.option-button:hover {
  transform: translateY(-2px);
  border-color: var(--rose-dark);
  background: #fff0f4;
}

.option-button.active {
  border-color: var(--rose-dark);
  background: linear-gradient(135deg, #e69aae, var(--rose-dark));
  color: white;
  box-shadow: 0 14px 30px rgba(159, 79, 104, 0.28);
}

.option-group.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.option-group.disabled .option-button,
.option-group.disabled .option-button.active {
  border-color: rgba(217, 140, 161, 0.22);
  background: #f6e7ec;
  color: #a98590;
  box-shadow: none;
  cursor: not-allowed;
  transform: none;
}

.form-button {
  display: block;
  width: fit-content;
  min-width: 220px;
  padding: 16px 44px;
  margin: 16px auto 0;
  font-size: 18px;
  z-index: 2;
}

.whatsapp-button {
  min-width: 220px;
  margin-top: 18px;
}

.rsvp-whatsapp-button {
  display: block;
  min-width: 240px;
  margin: 14px auto 0;
  padding: 16px 40px;
  font-size: 17px;
  border-radius: 999px;
  box-shadow: 0 14px 34px rgba(111,47,67,0.12);
}

.guest-stats {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  max-width: 860px;
  margin: 30px auto;
}

.guest-stats div,
.guest-item,
.wish-item {
  border: 1px solid rgba(217, 140, 161, 0.3);
  background: var(--paper-soft);
}

.guest-stats div {
  padding: 24px 16px;
  border-radius: 24px;
}

.guest-list,
.wish-list {
  position: relative;
  max-width: 860px;
  margin: 28px auto 0;
  display: grid;
  gap: 14px;
}

.guest-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  padding: 18px 20px;
  border-radius: 20px;
  text-align: left;
}

.guest-item strong,
.wish-item strong {
  display: block;
  color: var(--rose-deep);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 21px;
  font-weight: 800;
}

.guest-item span {
  display: block;
  margin-top: 4px;
  color: var(--text-soft);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-weight: 600;
}

.guest-item em {
  color: var(--rose-dark);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-style: normal;
  font-weight: 800;
}

.empty-text {
  font-size: 18px !important;
}

.wish-item {
  padding: 24px;
  border-radius: 24px;
}

.wish-item p {
  color: var(--text);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 21px;
  font-weight: 600;
}

.wish-item strong {
  margin-top: 12px;
  color: var(--rose-dark);
  font-size: 20px;
}

.footer {
  padding: 50px 18px 0;
  text-align: center;
}

.footer p {
  margin: 0;
  color: var(--rose-dark);
  font-family: "Great Vibes", "Noto Serif", cursive;
  font-size: clamp(48px, 7vw, 86px);
  line-height: 1.2;
  text-shadow: 0 8px 24px rgba(217, 140, 161, 0.28);
}

.footer span {
  display: block;
  margin-top: 8px;
  color: var(--rose-dark);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 3px;
  text-transform: uppercase;
}

.footer small {
  display: block;
  margin-top: 18px;
  color: #9a6d78;
}

.rsvp-form textarea,
.wish-form textarea {
  min-height: 80px !important; 
  height: 80px !important; 
  padding: 14px 18px !important; 
}

.theme-picker-grid {
  display: grid !important;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)) !important;
  gap: 16px !important;
  width: 100% !important;
}

.theme-option-card {
  position: relative !important;
  display: flex !important;
  flex-direction: column !important; 
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
  padding: 24px 12px 20px !important;
  gap: 10px !important;
  border-radius: 20px !important;
  background: var(--paper-soft, #fff) !important;
  border: 1.5px solid rgba(159, 79, 104, 0.2) !important;
  transition: all 0.2s ease !important;
}

.theme-option-card .theme-swatch {
  width: 36px !important;
  height: 36px !important;
  border-radius: 50% !important;
  margin: 0 !important;
  display: block !important;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1) !important;
}

[data-theme-preview="rose"] .theme-swatch { background: linear-gradient(135deg, #f8d7e2, #d98ca1) !important; }
[data-theme-preview="sage"] .theme-swatch { background: linear-gradient(135deg, #dce8c8, #9cad75) !important; }
[data-theme-preview="gold"] .theme-swatch { background: linear-gradient(135deg, #f4dfad, #c9a45d) !important; }
[data-theme-preview="burgundy"] .theme-swatch { background: linear-gradient(135deg, #e2b6c4, #b55b79) !important; }
[data-theme-preview="lavanta"] .theme-swatch { background: linear-gradient(135deg, #e6dcf2, #9b7cbf) !important; }
[data-theme-preview="minimal"] .theme-swatch { background: linear-gradient(135deg, #e8e1dc, #b69f91) !important; }
[data-theme-preview="dark"] .theme-swatch { background: linear-gradient(135deg, #5c5c5c, #2a2a2a) !important; }

.theme-option-card strong {
  font-size: 16px !important;
  line-height: 1.25 !important;
  margin: 4px 0 0 !important;
  width: 100% !important;
  color: var(--rose-deep) !important;
}

.theme-option-card small {
  font-size: 12px !important;
  opacity: 0.75 !important;
  margin: 0 !important;
  font-family: var(--sans) !important;
}

.theme-option-card.active {
  border-color: var(--amp-color, #9f4f68) !important;
  background: color-mix(in srgb, var(--amp-color) 8%, transparent) !important;
  transform: translateY(-3px) scale(1.02) !important;
}

.theme-option-card.active::after {
  content: "✓" !important;
  position: absolute !important;
  top: -10px !important;
  right: -10px !important;
  width: 26px !important;
  height: 26px !important;
  background: var(--amp-color, #9f4f68) !important;
  color: #fff !important;
  border-radius: 50% !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 14px !important;
  font-weight: bold !important;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2) !important;
}

.theme-option-card {
  overflow: visible !important; 
}

.theme-option-card.active::after {
  z-index: 10 !important; 
  top: -10px !important; 
  right: -10px !important;
}


.floating-actions {
  position: fixed;
  top: 22px;
  right: 22px;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.floating-actions .share-button {
  width: 145px;
  height: 62px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  text-decoration: none;
  background: rgba(255, 250, 251, 0.9);
  color: #9f4f68;
  border: 1px solid rgba(217, 140, 161, 0.34);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 19px;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 12px 30px rgba(111, 47, 67, 0.12);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
}

.floating-actions .music-toggle-button {
  width: 56px !important;
  height: 56px !important;
  min-width: 56px !important;
  padding: 0 !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  align-self: flex-end;
  border-radius: 50% !important;
  border: 1px solid rgba(217, 140, 161, 0.36) !important;
  background: rgba(255, 250, 251, 0.82) !important;
  color: #9f4f68 !important;
  box-shadow: 0 10px 24px rgba(111, 47, 67, 0.14) !important;
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  line-height: 1 !important;
}

.floating-actions .music-toggle-button svg {
  width: 30px;
  height: 30px;
}

.envelope-guest-badge {
  position: absolute !important;
  bottom: 24px !important;
  right: 28px !important;
  z-index: 20 !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
  border-radius: 0 !important;
  font-family: "Playfair Display", "Noto Serif", Georgia, serif !important;
  font-size: 15px !important;
  font-weight: 800 !important;
  color: var(--amp-color) !important;
  letter-spacing: 0.5px !important;
  
  opacity: 1 !important; 
  visibility: visible !important;
  
  font-style: normal !important;
  text-align: right !important;
  max-width: 45% !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  pointer-events: none !important;
  
  transform: translateZ(30px) !important;
  transition: opacity 0.4s ease 0.8s, visibility 0.4s ease 0.8s !important;
}

.intro-page.opening .envelope-guest-badge {
  opacity: 0 !important;
  visibility: hidden !important;
}

@media (max-width: 900px) {
  .invitation-page {
    padding: 22px 16px 60px;
  }

  .hero-section {
    min-height: 560px;
    padding: 64px 18px;
    background:
      radial-gradient(
        circle at center,
        rgba(120, 52, 78, 0.10) 0%,
        rgba(120, 52, 78, 0.20) 48%,
        rgba(60, 24, 38, 0.30) 100%
      ),
      var(--hero-image) center/cover no-repeat;
  }

  .gallery-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .guest-stats {
    grid-template-columns: 1fr;
  }
}

.glass-dock {
  position: fixed !important;
  top: 50% !important;
  right: 20px !important;
  transform: translateY(-50%) !important; 
  z-index: 9999 !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  gap: 12px !important;
  padding: 0 !important; /* Kutu kalktığı için iç boşluğa gerek yok */
  
  /* ARKA PLAN VE BLUR EFEKTİNİ KALDIRAN KISIM */
  background: transparent !important; 
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
  border: none !important;
  box-shadow: none !important;
}

.glass-dock .dock-btn {
  width: 46px !important; 
  height: 46px !important;
  min-width: 46px !important;
  border-radius: 50% !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  margin: 0 !important;
  
  background: rgba(255, 255, 255, 0.4) !important;
  color: var(--text-soft, #777) !important; 
  border: 1px solid rgba(255, 255, 255, 0.7) !important; 
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03) !important;
  
  transition: all 0.3s ease !important;
  text-decoration: none !important;
  font-family: "Playfair Display", serif !important;
  font-size: 14px !important;
  font-weight: 800 !important;
  cursor: pointer !important;
}

.glass-dock .dock-btn:hover {
  transform: translateY(-3px) scale(1.05) !important;
  background: #ffffff !important;
  color: var(--rose-dark, #9f4f68) !important; 
  border-color: #ffffff !important;
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08) !important;
}

.glass-dock .dock-btn svg {
  width: 20px !important;
  height: 20px !important;
  stroke: currentColor !important;
  fill: none !important;
  transition: stroke 0.3s ease !important;
}

[data-theme="dark"] .glass-dock {
  background: transparent !important;
  border: none !important;
}

[data-theme="dark"] .glass-dock .dock-btn {
  background: rgba(255, 255, 255, 0.05) !important;
  color: rgba(255, 255, 255, 0.5) !important;
  border-color: rgba(255, 255, 255, 0.08) !important;
}

[data-theme="dark"] .glass-dock .dock-btn:hover {
  background: rgba(255, 255, 255, 0.15) !important;
  color: var(--rose-light, #f8d7df) !important;
  border-color: rgba(255, 255, 255, 0.2) !important;
}

.hero-content > * {
  animation: heroFadeUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.hero-content .small-title { animation-delay: 0.2s; }
.hero-content .couple-title { animation-delay: 0.4s; }
.hero-content .hero-date { animation-delay: 0.6s; }
.hero-content .hero-time { animation-delay: 0.8s; }
.hero-content .hero-guest-greeting { animation-delay: 1.0s; }

@keyframes heroFadeUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.scroll-indicator {
  position: absolute;
  bottom: 15px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: rgba(255, 255, 255, 0.7);
  font-family: "Playfair Display", serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  z-index: 10;
  animation: heroFadeUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) 1.2s both;
}

.scroll-indicator .mouse {
  width: 22px;
  height: 34px;
  border: 1.5px solid rgba(255, 255, 255, 0.6);
  border-radius: 12px;
  position: relative;
}

.scroll-indicator .wheel {
  width: 2px;
  height: 6px;
  background: #ffffff;
  border-radius: 2px;
  position: absolute;
  top: 6px;
  left: 50%;
  transform: translateX(-50%);
  animation: scrollWheel 1.5s infinite ease-in-out;
}

@keyframes scrollWheel {
  0% { top: 6px; opacity: 1; }
  100% { top: 18px; opacity: 0; }
}

.admin-shell-card {
  animation: adminScaleUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.admin-page-header {
  animation: adminFadeUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s both;
}

.admin-login {
  animation: adminFadeUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.3s both;
}

.admin-sidebar {
  animation: adminFadeRight 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.3s both;
}

.admin-main-panel {
  animation: adminFadeUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.45s both;
}

@keyframes adminScaleUp {
  from { 
    opacity: 0; 
    transform: scale(0.97); 
  }
  to { 
    opacity: 1; 
    transform: scale(1); 
  }
}

@keyframes adminFadeUp {
  from { 
    opacity: 0; 
    transform: translateY(30px); 
  }
  to { 
    opacity: 1; 
    transform: translateY(0); 
  }
}

@keyframes adminFadeRight {
  from { 
    opacity: 0; 
    transform: translateX(-30px); 
  }
  to { 
    opacity: 1; 
    transform: translateX(0); 
  }
}

body .app .floating-actions button.music-toggle-button.music-on,
body .app .glass-dock .dock-btn.music-on {
  animation: musicPulseGlow 1.8s infinite ease-in-out !important;
  border-color: var(--amp-color, #9f4f68) !important;
}

@keyframes musicPulseGlow {
  0% {
    box-shadow: 0 0 0 0 rgba(159, 79, 104, 0.45);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 0 0 12px rgba(159, 79, 104, 0);
    transform: scale(1.04);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(159, 79, 104, 0);
    transform: scale(1);
  }
}

.lightbox-control-btn {
