  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-top: 34px;
}

.gallery-grid img {
  width: 100%;
  height: 260px;
  object-fit: cover;
  border: 1px solid rgba(255, 230, 237, 0.7);
  border-radius: 28px;
  box-shadow: 0 18px 42px rgba(111, 47, 67, 0.18);
}

.rsvp-card {
  overflow: visible;
  border: 1px solid rgba(217, 140, 161, 0.42);
  background:
