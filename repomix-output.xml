}

.option-group.disabled .option-button,
.option-group.disabled .option-button.active {
  border-color: rgba(217, 140, 161, 0.22);
  background: #f6e7ec;
  color: #a98590;
  box-shadow: none;
  cursor: not-allowed;
  transform: none;
}

.form-button {
  display: block;
  width: fit-content;
  min-width: 220px;
  padding: 16px 44px;
  margin: 16px auto 0;
  font-size: 18px;
  z-index: 2;
}

.whatsapp-button {
  min-width: 220px;
  margin-top: 18px;
}

.rsvp-whatsapp-button {
  display: block;
  min-width: 240px;
  margin: 14px auto 0;
