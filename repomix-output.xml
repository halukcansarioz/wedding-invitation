.app-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22px;
  background:
    radial-gradient(circle at 50% 30%, rgba(var(--theme-rgb, 217, 140, 161), 0.18), transparent 34%),
    rgba(25, 14, 18, 0.46);
  backdrop-filter: blur(10px);
  animation: modalBackdropIn 0.18s ease both;
}

.app-modal-card {
  position: relative;
  width: min(92vw, 440px);
  padding: 26px 26px 22px;
  gap: 14px;
  margin: 0;
  display: grid;
  color: var(--theme-text-main, var(--text));
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.76), rgba(255, 255, 255, 0.45)),
    var(--theme-surface, var(--paper));
  border: 1px solid rgba(var(--theme-rgb, 217, 140, 161), 0.32);
  border-radius: 30px;
  box-shadow:
    0 32px 90px rgba(36, 18, 25, 0.24),
    inset 0 1px 0 rgba(255, 255, 255, 0.50);
  overflow: hidden;
  animation: modalCardIn 0.22s ease both;
}

.app-modal-card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 6px;
  background: linear-gradient(90deg, var(--rose), var(--rose-dark), var(--gold));
}

.app-modal-icon {
  display: none;
}

.app-modal-content {
  display: grid;
  gap: 8px;
}

.app-modal-content p {
  margin: 0;
  color: var(--theme-text-muted, var(--text-soft));
  font-size: 17px;
  font-weight: 750;
  line-height: 1.55;
}

.app-modal-input {
  width: 100%;
  min-height: 52px;
  margin-top: 8px;
  padding: 14px 16px;
  color: var(--theme-text-main, var(--text));
  background: var(--theme-input, rgba(255, 250, 251, 0.96));
  border: 1px solid rgba(var(--theme-rgb, 217, 140, 161), 0.32);
  border-radius: 17px;
  outline: none;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.44);
  font-size: 17px;
  font-weight: 750;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

.app-modal-input:focus {
  border-color: rgba(var(--theme-rgb, 217, 140, 161), 0.72);
  box-shadow:
    0 0 0 4px rgba(var(--theme-rgb, 217, 140, 161), 0.14),
    inset 0 1px 0 rgba(255, 255, 255, 0.44);
  transform: translateY(-1px);
}

.app-modal-textarea {
  min-height: 116px;
  resize: vertical;
  line-height: 1.5;
}

.app-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  flex-wrap: wrap;
  padding-top: 4px;
}

.app-modal-actions .main-button,
.app-modal-actions .secondary-button {
  min-height: 46px;
  padding: 12px 20px;
  border-radius: 999px;
  font-size: 15px;
  font-weight: 900;
}

.app-modal-cancel {
  color: var(--rose-deep);
  background: rgba(var(--theme-rgb, 217, 140, 161), 0.10);
  border-color: rgba(var(--theme-rgb, 217, 140, 161), 0.24);
}

.app-modal-danger-button {
  background: linear-gradient(135deg, #c94f67, #7a203b);
  color: #fff;
}

.app-modal-warning .app-modal-icon {
  background: linear-gradient(135deg, var(--gold), var(--rose-dark));
}

.app-modal-success .app-modal-icon {
  background: linear-gradient(135deg, #8fb46b, var(--rose-dark));
}

.app-modal-danger .app-modal-icon,
.app-modal-danger .app-modal-card::before {
  background: linear-gradient(135deg, #e06d7f, #8d263f);
}

.app-modal-success .app-modal-card::before {
  background: linear-gradient(90deg, #9fc47d, var(--rose), var(--rose-dark));
}

@keyframes modalBackdropIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes modalCardIn {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

