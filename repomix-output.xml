  font-size: 46px;
  font-weight: 800;
}

.count-box span,
.guest-stats span {
  display: block;
  margin-top: 10px;
  color: #7a4a58;
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.info-list {
  position: relative;
  max-width: 900px;
  margin: 28px auto 8px;
  overflow: hidden;
  border: 1px solid rgba(217, 140, 161, 0.34);
  border-radius: 26px;
  background: var(--paper-soft);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 26px;
  padding: 20px 26px;
  border-bottom: 1px solid rgba(217, 140, 161, 0.22);
  text-align: left;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row span,
.timeline-item span {
  color: var(--rose-dark);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-weight: 800;
}

.info-row span {
  font-size: 15px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.info-row strong {
  color: var(--text);
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 22px;
  font-weight: 700;
}

.mini-map {
  position: relative;
  max-width: 900px;
  height: 360px;
  margin: 30px auto 0;
  overflow: hidden;
  border: 1px solid rgba(217, 140, 161, 0.36);
  border-radius: 28px;
  background: var(--paper-soft);
  box-shadow: 0 18px 42px rgba(111, 47, 67, 0.16);
}

.mini-map iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
}

.button-group {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
  margin-top: 28px;
}

.main-button,
.secondary-button {
  display: inline-block;
  padding: 16px 36px;
  border-radius: 999px;
  text-decoration: none;
  font-family: "Playfair Display", "Noto Serif", Georgia, serif;
  font-size: 16px;
  font-weight: 800;
