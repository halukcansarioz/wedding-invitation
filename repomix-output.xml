}

.footer small {
  display: block;
  margin-top: 18px;
  color: #9a6d78;
}

.rsvp-form textarea,
.wish-form textarea {
  min-height: 80px !important; 
  height: 80px !important; 
  padding: 14px 18px !important; 
}

.theme-picker-grid {
