{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "scroll-margin-top",
          "overscroll-behavior-y",
          "overscroll-behavior-y: auto",
          "scroll-behavior",
          "scroll-snap-stop",
          "scroll-snap-stop: always",
          "scroll-behavior: smooth",
          "position: sticky",
          "overscroll-behavior-y: none",
          "border: 1.5px dashed color-mix(in srgb, var(--amp-color) 40%, transparent)",
          "border: 1.5px solid color-mix(in srgb, var(--amp-color) 35%, transparent)",
          "-webkit-user-drag"
        ]
      }
    ],
    "meta-viewport": "off",
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "meta[name=theme-color]"
        ]
      }
    ]
  }
}