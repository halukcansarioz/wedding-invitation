{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "scroll-margin-top",
          "overscroll-behavior-y",
          "overscroll-behavior-y: auto",
          "scroll-behavior",
          "scroll-snap-stop",
          "scroll-snap-stop: always",
          "scroll-behavior: smooth",
          "position: sticky",
          "overscroll-behavior-y: none"
        ]
      }
    ]
  }
}